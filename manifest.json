{
  "manifest_version": 3,
  "name": "StyleCraft",
  "version": "1.14.0",
  "description": "Customize any website's appearance with custom CSS. Pick elements visually, write CSS directly, or install community styles from UserStyles.world.",
  "homepage_url": "https://github.com/SysAdminDoc/StyleCraft",
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "style-match.js",
        "inject-styles.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      }
    },
    "toggle_editor": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Toggle StyleCraft Editor"
    }
  }
}
