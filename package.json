{
  "name": "stylecraft",
  "version": "1.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:codemirror": "esbuild tools/codemirror-entry.js --bundle --format=iife --global-name=StyleCraftCodeMirrorBundle --outfile=vendor/codemirror/stylecraft-codemirror.js --legal-comments=none --minify",
    "build:zip": "node tools/build-extension.mjs",
    "test": "node tools/validate-extension.mjs && playwright test tests/editor-smoke.spec.mjs --browser=chromium"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@playwright/test": "^1.61.1",
    "esbuild": "^0.28.1"
  }
}
