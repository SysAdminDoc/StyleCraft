{
  "name": "stylecraft",
  "version": "1.15.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:codemirror": "esbuild tools/codemirror-entry.js --bundle --format=iife --global-name=StyleCraftCodeMirrorBundle --outfile=vendor/codemirror/stylecraft-codemirror.js --legal-comments=none --minify && node tools/clean-generated.mjs vendor/codemirror/stylecraft-codemirror.js",
    "build:sass": "esbuild tools/sass-entry.js --bundle --format=iife --global-name=StyleCraftSassBundle --outfile=vendor/sass/stylecraft-sass.js --legal-comments=none --minify --inject:tools/browser-process-shim.js && node tools/clean-generated.mjs vendor/sass/stylecraft-sass.js",
    "build:postcss": "esbuild tools/postcss-entry.js --bundle --format=iife --global-name=StyleCraftPostCSSBundle --outfile=vendor/postcss/stylecraft-postcss.js --legal-comments=none --minify --inject:tools/browser-process-shim.js && node tools/clean-generated.mjs vendor/postcss/stylecraft-postcss.js",
    "build": "npm run build:codemirror && npm run build:sass && npm run build:postcss",
    "build:zip": "node tools/build-extension.mjs",
    "test": "node tools/validate-extension.mjs && playwright test tests/matcher-smoke.spec.mjs tests/options-import-smoke.spec.mjs tests/editor-smoke.spec.mjs tests/content-picker-smoke.spec.mjs --browser=chromium"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@playwright/test": "^1.61.1",
    "autoprefixer": "^10.5.2",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.15",
    "postcss-nesting": "^14.0.0",
    "sass": "^1.101.0"
  }
}
